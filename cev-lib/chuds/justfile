# use powershell on windows
set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

[private]
default:
    @just --list

configure:
    cmake -S . -B build -G Ninja

build: configure
    cmake --build build

test: build
    ctest --test-dir build --output-on-failure

clean:
    cmake -E rm -rf build

# create a virtual CAN-FD interface for the socketcan tests and chuds_demo
[linux]
vcan-up iface="vcan0":
    sudo modprobe vcan
    if ! ip link show {{ iface }} >/dev/null 2>&1; then sudo ip link add dev {{ iface }} type vcan; fi
    sudo ip link set {{ iface }} down
    sudo ip link set {{ iface }} mtu 72
    sudo ip link set up {{ iface }}

# install a service that brings can0 up at the bus settings in frame.hpp whenever it appears
# rerun after changing frame.hpp
[linux]
install-can: build
    sudo install -m 755 build/tools/can_link_args /usr/local/bin/can_link_args
    sudo install -m 644 tools/can0-up.service /etc/systemd/system/can0-up.service
    sudo systemctl daemon-reload
    sudo systemctl enable can0-up.service
    if ip link show can0 >/dev/null 2>&1; then sudo systemctl restart can0-up.service; fi

# lint every file the build compiles, except fetched and generated code
[unix]
lint *args: configure
    #!/usr/bin/env bash
    set -euo pipefail
    # run-clang-tidy prints each file's full command and a "N warnings generated" tally; drop both
    run-clang-tidy -p build -quiet {{ args }} '^((?!/build/).)*$' 2>&1 \
        | { grep -vE '^\[[0-9]+/[0-9]+\]\[|[0-9]+ warnings generated\.$' || true; } | cat -s
