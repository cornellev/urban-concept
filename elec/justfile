set default-list

# use powershell on windows
set windows-shell := ["powershell.exe", "-NoProfile", "-Command"]

# picotool: bundled binary on windows, on PATH elsewhere
picotool := if os() == "windows" { '& "' + replace(module_directory() / ".tools" / "picotool" / "picotool.exe", "\\", "/") + '"' } else { "picotool" }

# configure all targets
configure:
    cmake -S . -B build -G Ninja

# build all targets
build: configure
    cmake --build build

# build a single target
build-target target: configure
    cmake --build build --target {{ target }}

# clean build artifacts
clean:
    cmake -E rm -rf build

# flash a project onto a pico
flash target: (build-target target)
    {{ picotool }} load -x build/src/{{ target }}/{{ target }}.uf2

# ensure installed toolchain versions are as expected
doctor:
    @cmake -P setup/doctor.cmake

# fail if any firmware image links the heap allocator
[unix]
audit-heap: build
    #!/usr/bin/env bash
    set -euo pipefail
    status=0
    for elf in build/src/*/*.elf; do
        n=$(arm-none-eabi-nm -C "$elf" | grep -ciE '\b(malloc|free|_sbrk)\b|operator new|operator delete' || true)
        echo "$elf: $n heap symbols"
        [ "$n" -eq 0 ] || status=1
    done
    exit "$status"

# run clang-tidy on the firmware and our headers
# clang-tidy can't query arm-none-eabi-g++, so pass its target and system headers by hand
[unix]
lint: build
    #!/usr/bin/env bash
    set -euo pipefail
    args=(--extra-arg=--target=arm-none-eabi --extra-arg=-mcpu=cortex-m0plus --extra-arg=-nostdinc)
    while read -r dir; do
        args+=(--extra-arg=-isystem --extra-arg="$dir")
    done < <(arm-none-eabi-g++ -xc++ -E -v /dev/null 2>&1 | sed -n '/search starts here/,/End of search/p' | grep '^ ' | sed 's/^ //')
    clang-tidy -p build --quiet --warnings-as-errors='*' \
        --header-filter='.*/(cev-lib/chuds|elec/src)/.*' "${args[@]}" $(git ls-files 'src/*.cpp')
